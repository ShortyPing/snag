assert_eq(1 + 1, 2);
assert_eq("snag", "snag");
assert_contains("regression suite", "suite");
assert(base_url.starts_with("https://"), "base_url must be https");
assert_eq(max_latency_ms * 2, 1600);
assert_eq(retries.len(), 3);
assert_eq(retries[2], 3);

let stage = env_or("SNAG_STAGE", "local");
print(`running against ${stage}`);
