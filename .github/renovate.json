{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "cargo": {
    "commitMessageTopic": "{{depName}}"
  },
  "packageRules": [
    {
      "description": "Patch and minor Cargo bumps land in one PR; the suite is offline so CI verifies them cheaply.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo dependencies"
    },
    {
      "description": "Docusaurus ships core, preset, and tsconfig on one version line — split PRs would not build.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@docusaurus/**"],
      "groupName": "docusaurus"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom", "@types/react"],
      "groupName": "react"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Node 20 is the documented floor for the docs site; a major bump is a deliberate change.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true
}
